# 로컬: 이 파일을 .env.local로 복사해서 채운다. Vercel: Project Settings → Environment Variables에 같은 이름으로 넣는다
# 모두 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이지 않는다

# Supabase (D-065) — 앱에는 넣지 않는다. Vercel Supabase 연동을 쓰면 NEXT_PUBLIC_SUPABASE_URL·SUPABASE_SERVICE_ROLE_KEY가 자동으로 들어가므로 따로 넣지 않는다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 공유 이름용 역지오코딩 (D-058). 비우면 공개 Nominatim을 쓴다 — 초당 1건 제한, 연락처가 들어간 User-Agent 필수
NOMINATIM_URL=
NOMINATIM_USER_AGENT=onmyway-dev
